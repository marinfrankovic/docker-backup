# ---------------------------------------------------------------------------
# docker-backup configuration
#
# 1. Copy this file to ".env"  (cp .env.example .env)
# 2. Edit the values below for your machine.
# 3. Run:  docker compose up -d
#
# The .env file is git-ignored, so your local settings are never committed.
# ---------------------------------------------------------------------------

# REQUIRED — host folder where all backups are stored.
# This MUST be a real path on the machine running Docker, and it is used both
# as the volume mount AND for sibling helper containers, so keep it accurate.
#   Windows (use forward slashes):  E:/Docker/backups   or   C:/docker-backups
#   Linux / macOS:                  /srv/docker-backups  or  /home/you/backups
BACKUP_ROOT_HOST=/srv/docker-backups

# Your local timezone (used by the backup scheduler so jobs run at local time).
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: UTC, Europe/London, America/New_York, Europe/Zagreb
TZ=UTC

# OPTIONAL — defaults are fine for most people.
# Hour (0-23) used for the first auto-created schedule.
BACKUP_HOUR=3
# Default "keep last N runs" retention for new schedules.
RETENTION_DAYS=7
# Web GUI port (served on http://127.0.0.1:<port>, localhost only).
GUI_PORT=8088
# Helper image used to archive volumes (no need to change).
HELPER_IMAGE=alpine:3.20
